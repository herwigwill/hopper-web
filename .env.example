# Copy to .env for local dev, and set the same names in Vercel → Project → Settings → Environment Variables.

# Loops API key (Loops → Settings → API). Without it, sign-ups are a dry run locally and refused in production.
LOOPS_API_KEY=

# Optional: a Loops mailing list id to add every sign-up to.
LOOPS_MAILING_LIST_ID=

# Any long random string (e.g. `openssl rand -base64 32`). Signs the token that lets a new sign-up save the optional answers.
WAITLIST_SECRET=

# Optional: requests per minute per address before the API answers 429 (default 6).
WAITLIST_RATE_LIMIT=
