{
  "name": "hopper-web",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Landing page for Hopper, the Mac app that takes you back to the exact thing you were working on.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "serve": "node --env-file-if-exists=.env scripts/serve.mjs",
    "check": "astro check",
    "test": "playwright test",
    "test:quick": "playwright test --project=chromium",
    "test:failed": "playwright test --last-failed",
    "verify": "npm run check && npm run build && npm test",
    "og": "node scripts/og.mjs",
    "blog:covers": "astro build && node scripts/blog-covers.mjs"
  },
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@iconify-json/logos": "^1.2.15",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
