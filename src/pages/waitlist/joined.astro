---
import Base from "../../layouts/Base.astro";
---
<Base title="You're on the list · Hopper" path="/waitlist/joined" noindex>
  <section class="wrap msg">
    <h1>You’re on the list.</h1>
    <p>We’ll email you when Hopper is ready for you.</p>
    <a href="/">Back to the Hopper page</a>
  </section>
</Base>
<style>
  .msg { padding-block: 6rem 8rem; display: grid; gap: 1.25rem; justify-items: start; }
  h1 { font-size: var(--step-3); }
  p { font-size: var(--step-1); color: var(--ink-2); }
</style>
