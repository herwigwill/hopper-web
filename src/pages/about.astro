---
/**
 * About. The story is Matt's, in his words (lightly edited), as short quotes; Will's is his own. The team is drawn as a
 * Hopper search panel (launcher.css), the site's signature, instead of photos.
 */
import "../styles/launcher.css";
import Base from "../layouts/Base.astro";
import HopperMark from "../components/HopperMark.astro";
import Join from "../moments/Join.astro";
import { site } from "../content/facts";

const quotes = [
  { text: "A new app would come out, I’d learn its shortcuts, and a month later I’d move on to the next one.", who: "Matt Herwig", role: "Founder" },
  { text: "Even with Raycast, I was still hopping between apps and setting up custom shortcuts for each one.", who: "Matt Herwig", role: "Founder" },
  { text: "In this new age of AI, I wanted better ways to get around. So I built them.", who: "Matt Herwig", role: "Founder" },
  { text: "I always had 40 tabs open and no idea where anything was. Now I hit ⌘Space, type two letters, and I’m there.", who: "Will Herwig", role: "Growth" },
];
const team = [
  { initials: "MH", name: "Matt Herwig", role: "Founder", tone: "blue" },
  { initials: "WH", name: "Will Herwig", role: "Growth", tone: "night" },
];
---
<Base title="About · Hopper" description="Hopper is built by a small independent team who wanted a faster way around the Mac." path="/about">
  <section class="ab-hero">
    <div class="wrap grid">
      <div>
        <h1>We built the app we kept wishing&nbsp;for.</h1>
        <p class="lede">Hopper is made by a small, independent team in Jersey City, NJ, for anyone who spends the day hopping between apps.</p>
      </div>
      <figure class="city" aria-hidden="true">
        <svg viewBox="0 0 520 300" class="skyline">
          <rect x="0" y="0" width="520" height="300" rx="24" fill="var(--blue)" />
          <circle cx="410" cy="78" r="34" fill="var(--sun)" />
          <!-- Hudson waterfront, roughly: towers of varying heights -->
          <g fill="#1b26b5">
            <rect x="24" y="170" width="40" height="130" />
            <rect x="70" y="140" width="34" height="160" />
            <rect x="110" y="100" width="46" height="200" />
            <rect x="162" y="150" width="30" height="150" />
            <rect x="198" y="118" width="52" height="182" />
            <rect x="256" y="160" width="36" height="140" />
            <rect x="298" y="128" width="44" height="172" />
            <rect x="348" y="176" width="40" height="124" />
            <rect x="394" y="150" width="50" height="150" />
            <rect x="450" y="186" width="46" height="114" />
          </g>
          <g fill="#4a58ff" opacity=".55">
            {[0, 1, 2, 3, 4, 5, 6, 7].map((r) => [118, 132, 146].map((x) => <rect x={x} y={112 + r * 20} width="6" height="9" rx="1" />))}
            {[0, 1, 2, 3, 4, 5, 6].map((r) => [208, 222, 236].map((x) => <rect x={x} y={130 + r * 20} width="6" height="9" rx="1" />))}
          </g>
          <rect x="0" y="262" width="520" height="38" fill="#121a8f" />
          <path d="M0 274h520M30 286h460" stroke="#4a58ff" stroke-width="2" stroke-dasharray="14 18" opacity=".6" />
        </svg>
        <span class="bun"><HopperMark /></span>
      </figure>
    </div>
  </section>

  <section class="story" id="story" aria-labelledby="story-title">
    <div class="wrap">
      <h2 id="story-title">Why Hopper exists.</h2>
      <ul class="quotes">
        {quotes.map((q, i) => (
          <li class:list={{ lead: i === 0 }}>
            <blockquote>
              <p>{q.text}</p>
              <footer><b>{q.who}</b>, {q.role}</footer>
            </blockquote>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="team" id="team" aria-labelledby="team-title">
    <div class="wrap grid">
      <div>
        <h2 id="team-title">Who we are.</h2>
        <p class="lede">Two of us, building Hopper with the people who use it. It’s in private testing now.</p>
      </div>
      <div class="stage on-blue">
        <div class="lx-box">
          <div class="lx">
            <div class="lx-head"><span class="lx-text q">team</span><span class="lx-caret" aria-hidden="true"></span></div>
            <div class="lx-rule"></div>
            <ul class="lx-list" aria-label="The Hopper team">
              <li class="lx-section" aria-hidden="true">Team</li>
              {team.map((t, i) => (
                <li class:list={["lx-row", { sel: i === 0 }]}>
                  <span class:list={["av", `av-${t.tone}`]} aria-hidden="true">{t.initials}</span>
                  <span class="lx-title">{t.name}</span>
                  <span class="lx-sub">{t.role}</span>
                </li>
              ))}
              <li class="lx-section" aria-hidden="true">Next</li>
              <li><a class="lx-row you" href="#join"><span class="av av-sun" aria-hidden="true">+</span><span class="lx-title">You</span><span class="lx-sub">Early tester</span><span class="lx-acc">Join the waitlist</span></a></li>
            </ul>
            <div class="lx-foot"><span>Hopper</span><a class="lx-primary" href={`mailto:${site.contact}`}>Say hello</a><span class="lx-kbd" aria-hidden="true">↵</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Join />
</Base>

<style>
  section {
    padding-block: clamp(4rem, 3rem + 5vw, 8rem);
  }
  .ab-hero {
    padding-top: clamp(2rem, 1rem + 3vw, 4rem);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 2.5rem clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  h1 {
    max-width: 11ch;
    font-size: clamp(2.75rem, 1.6rem + 4.4vw, 5.75rem);
  }
  .lede {
    margin-top: 1.5rem;
    max-width: 34ch;
  }
  .city {
    position: relative;
    margin: 0;
  }
  .skyline {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 24px;
  }
  /* The bunny hiding behind a rooftop (the tallest tower, x 110–156, top y 100 of 300): its ears duck below the roof
     and pop back up. The box clips at the roof line. */
  .bun {
    position: absolute;
    left: calc(133 / 520 * 100%);
    bottom: calc(200 / 300 * 100%);
    width: 7%;
    color: var(--white);
    transform: translateX(-50%);
    clip-path: inset(-100% -100% 0 -100%);
  }
  .bun :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .bun :global(.ear) {
    transform-box: view-box;
    transform-origin: var(--pivot);
    animation: peek 4.4s var(--ease-out) infinite;
  }
  .bun :global(.ear-r) {
    translate: 0 14px;
    animation-name: peek-r;
  }
  @keyframes peek {
    0%, 58%, 100% { transform: none; }
    64%, 74% { transform: translateY(185px); }
    84% { transform: translateY(-12px); }
    92% { transform: rotate(-3deg); }
  }
  @keyframes peek-r {
    0%, 60%, 100% { transform: none; }
    66%, 76% { transform: translateY(185px); }
    86% { transform: translateY(-8px) rotate(-8deg); }
    92% { transform: rotate(14deg); }
    96% { transform: rotate(-4deg); }
  }

  h2 {
    max-width: 14ch;
  }

  /* Quotes: one big, then three. */
  .quotes {
    list-style: none;
    margin: clamp(2.5rem, 2rem + 2vw, 4rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 3rem);
  }
  .quotes li {
    padding-top: 1.25rem;
    border-top: 2px solid var(--ink);
  }
  .quotes li.lead {
    grid-column: 1 / -1;
    border-top-color: var(--blue);
  }
  blockquote {
    margin: 0;
  }
  blockquote p {
    font-family: var(--display);
    font-weight: 800;
    font-stretch: 85%;
    font-size: var(--step-1);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .lead blockquote p {
    max-width: 22ch;
    font-size: var(--step-3);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  blockquote footer {
    margin-top: 1rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  blockquote footer b {
    color: var(--ink);
  }

  /* Who we are, as a search. */
  .team {
    background: var(--white);
    border-top: 1px solid var(--line);
  }
  .team .lede {
    margin-top: 1.5rem;
  }
  .stage {
    padding: clamp(1.25rem, 4vw, 3rem);
    border-radius: clamp(18px, 2vw, 28px);
    background:
      radial-gradient(120% 90% at 85% 0%, #4a58ff 0%, transparent 55%),
      var(--blue);
  }
  .lx-box {
    container-type: inline-size;
  }
  .lx {
    --lx-size: clamp(11px, calc(100cqw / 42), 14px);
    width: 100%;
  }
  .q {
    font-size: 1.55em;
  }
  .lx-list {
    height: auto;
    list-style: none;
  }
  .lx-list li {
    list-style: none;
  }
  .lx-row.sel {
    background: rgb(255 255 255 / 0.11);
  }
  .av {
    display: grid;
    place-items: center;
    width: 1.9em;
    height: 1.9em;
    flex: none;
    border-radius: 0.5em;
    font: 700 0.8em var(--text);
    color: #fff;
  }
  .av-blue {
    background: var(--blue);
  }
  .av-night {
    background: #3a3f63;
  }
  .av-sun {
    background: var(--sun);
    color: var(--night);
    font-size: 1em;
  }
  a.lx-row {
    color: inherit;
    text-decoration: none;
  }
  a.lx-row:hover,
  a.lx-row:focus-visible {
    background: rgb(255 255 255 / 0.11);
  }
  .you .lx-acc {
    color: var(--sun);
    font-weight: 600;
  }
  .lx-foot a {
    text-decoration: none;
  }
  .lx-foot a:hover {
    text-decoration: underline;
  }
  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: 1fr;
    }
    .quotes {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 30rem) {
    .lx-acc {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bun :global(.ear) {
      animation: none;
    }
  }
</style>
