---
/**
 * Help: a search that looks like Hopper's own (launcher.css), over every answer in content/help.ts. Without
 * JavaScript, or below the search, every topic is listed in full. Picking a result opens its answer in place.
 */
import "../styles/launcher.css";
import Base from "../layouts/Base.astro";
import { helpTopics } from "../content/help";
import { site } from "../content/facts";
import { ldJson } from "../lib/blog";

const faq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: helpTopics.flatMap((t) => t.articles.map((a) => ({ "@type": "Question", name: a.q, acceptedAnswer: { "@type": "Answer", text: a.a } }))),
};
const popular = ["spotlight", "tabs-missing", "permissions", "back", "agents-supported", "uploads"];
---
<Base title="Help · Hopper" description="Answers about setting up and using Hopper: permissions, shortcuts, search, Back, agents, windows and privacy." path="/help">
  <script slot="head" type="application/ld+json" is:inline set:html={ldJson(faq)} />

  <section class="hp-hero">
    <div class="wrap">
      <h1>How can we&nbsp;help?</h1>
      <div class="stage on-blue">
        <div class="lx-box">
          <div class="lx" data-help data-popular={popular.join(" ")}>
            <div class="lx-head">
              <label class="visually-hidden" for="help-q">Search help</label>
              <input id="help-q" class="q" type="search" placeholder="Search help…" autocomplete="off" spellcheck="false"
                role="combobox" aria-expanded="true" aria-controls="help-results" aria-autocomplete="list" data-q />
              <span class="lx-kbd hint" aria-hidden="true">/</span>
            </div>
            <div class="lx-rule"></div>
            <ul class="lx-list" id="help-results" role="listbox" aria-label="Results" data-results>
              <li class="lx-section" role="presentation">Popular</li>
              {popular.map((id) => {
                const t = helpTopics.find((t) => t.articles.some((a) => a.id === id))!;
                const a = t.articles.find((a) => a.id === id)!;
                return (
                  <li role="presentation"><a class="lx-row" role="option" href={`#${a.id}`} aria-selected="false"><span class="lx-title">{a.q}</span><span class="lx-sub">{t.title}</span></a></li>
                );
              })}
            </ul>
            <div class="lx-foot"><span role="status" data-say>Type a few words, like “spotlight” or “tabs”.</span><span class="lx-primary">Open Answer</span><span class="lx-kbd">↵</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="topics" aria-labelledby="all-title">
    <div class="wrap">
      <h2 id="all-title">Every answer.</h2>
      <nav class="jump" aria-label="Topics">
        {helpTopics.map((t) => <a href={`#topic-${t.id}`}>{t.title}</a>)}
      </nav>
      <div class="grid">
        {helpTopics.map((t) => (
          <section class="topic" id={`topic-${t.id}`} aria-labelledby={`h-${t.id}`}>
            <h3 id={`h-${t.id}`}>{t.title}</h3>
            {t.articles.map((a) => (
              <details id={a.id}>
                <summary>{a.q}</summary>
                <p>{a.a}</p>
                {a.link && <a class="more" href={a.link.href}>{a.link.label}<span aria-hidden="true"> →</span></a>}
              </details>
            ))}
          </section>
        ))}
      </div>
      <p class="mail">Didn’t find it? Watch it in <a href="/tips">Hopper Tips</a>, or email <a href={`mailto:${site.contact}`}>{site.contact}</a>.</p>
    </div>
  </section>
</Base>

<style>
  .hp-hero {
    padding-block: clamp(1.5rem, 1rem + 2.5vw, 3.5rem) clamp(3rem, 2rem + 4vw, 5rem);
  }
  h1 {
    font-size: clamp(3rem, 1.6rem + 5.2vw, 6rem);
  }
  .stage {
    margin-top: clamp(1.75rem, 1rem + 2.5vw, 3rem);
    padding: clamp(1.25rem, 4vw, 3.5rem) clamp(1rem, 6vw, 7rem);
    border-radius: clamp(18px, 2vw, 28px);
    background:
      radial-gradient(120% 90% at 85% 0%, #4a58ff 0%, transparent 55%),
      var(--blue);
  }
  .lx-box {
    container-type: inline-size;
    max-width: 52rem;
    margin-inline: auto;
  }
  .lx {
    --lx-size: clamp(12px, calc(100cqw / 52), 14px);
    width: 100%;
    user-select: auto;
  }
  .q {
    flex: 1;
    min-width: 0;
    border: 0;
    padding: 0;
    background: transparent;
    color: #fff;
    caret-color: var(--sun);
    font: inherit;
    font-size: 1.55em;
    outline: none;
  }
  .q::placeholder {
    color: rgb(235 235 245 / 0.4);
  }
  .q::-webkit-search-cancel-button {
    filter: invert(1);
  }
  .lx-head:focus-within {
    box-shadow: inset 0 -2px 0 var(--sun);
  }
  .hint {
    opacity: 0.6;
  }
  .lx-list {
    height: auto;
    min-height: 18em;
    max-height: 26em;
    overflow-y: auto;
  }
  .lx-list li {
    list-style: none;
  }
  .lx-list :global(a.lx-row) {
    color: inherit;
    text-decoration: none;
  }
  .lx-list :global(a.lx-row[aria-selected="true"]),
  .lx-list :global(a.lx-row:hover) {
    background: rgb(255 255 255 / 0.11);
  }
  .lx-list :global(.lx-title) {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .lx-list :global(mark) {
    background: none;
    color: var(--sun);
    font-weight: 600;
  }
  .lx-list :global(.lx-empty a) {
    color: var(--sun);
  }

  .topics {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem);
    background: var(--white);
    border-top: 1px solid var(--line);
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .jump a {
    padding: 0.4rem 0.85rem;
    border-radius: 2rem;
    background: var(--paper);
    box-shadow: 0 0 0 1px var(--line);
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
  }
  .jump a:hover {
    box-shadow: 0 0 0 2px var(--blue);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 4vw, 3.5rem) clamp(2rem, 5vw, 5rem);
    margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }
  .topic {
    scroll-margin-top: 5rem;
  }
  .topic h3 {
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--ink);
    font-size: var(--step-1);
  }
  details {
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 6rem;
  }
  summary {
    padding: 0.95rem 0;
    font-weight: 600;
    cursor: pointer;
  }
  summary:hover {
    color: var(--blue);
  }
  details p {
    color: var(--ink-2);
  }
  details > :last-child {
    margin-bottom: 1.1rem;
  }
  .more {
    display: inline-block;
    margin-top: 0.6rem;
    color: var(--blue);
    font-weight: 600;
    text-decoration: none;
  }
  .more:hover {
    text-decoration: underline;
  }
  .mail {
    margin-top: 3rem;
    color: var(--ink-2);
  }
  .mail a {
    color: var(--blue);
  }
  @media (max-width: 48rem) {
    .grid {
      grid-template-columns: 1fr;
    }
    .lx-list :global(.lx-sub),
    .hint {
      display: none;
    }
  }
</style>

<script>
  import { helpTopics } from "../content/help";
  import { escape } from "../scripts/launcher";
  import { site } from "../content/facts";

  const root = document.querySelector<HTMLElement>("[data-help]");
  if (root) {
    const input = root.querySelector<HTMLInputElement>("[data-q]")!;
    const list = root.querySelector<HTMLElement>("[data-results]")!;
    const say = root.querySelector<HTMLElement>("[data-say]")!;
    const popularHTML = list.innerHTML;
    const all = helpTopics.flatMap((t) => t.articles.map((a) => ({ ...a, topic: t.title })));

    const words = (s: string) => s.toLowerCase().normalize("NFKD").replace(/[̀-ͯ]/g, "").split(/[^a-z0-9⌘⌥⌃⇧]+/).filter(Boolean);
    const has = (hay: string[], t: string) => hay.some((w) => w.startsWith(t));

    /** Every word typed must start a word somewhere; the question counts most, then extra words, then the answer. */
    const find = (q: string) => {
      const ts = words(q);
      return all
        .map((a) => {
          const qw = words(a.q), kw = words(`${a.words ?? ""} ${a.topic}`), aw = words(a.a);
          let score = 0;
          for (const t of ts) {
            if (has(qw, t)) score += 3;
            else if (has(kw, t)) score += 2;
            else if (has(aw, t)) score += 1;
            else return null;
          }
          return { a, score };
        })
        .filter((x): x is NonNullable<typeof x> => x !== null)
        .sort((x, y) => y.score - x.score)
        .map((x) => x.a);
    };

    const mark = (text: string, q: string) => {
      const ts = words(q);
      return text
        .split(/(\s+)/)
        .map((w) => {
          const lw = w.toLowerCase();
          const t = ts.find((t) => lw.startsWith(t) || lw.replace(/^[^a-z0-9]+/, "").startsWith(t));
          if (!t) return escape(w);
          const at = lw.indexOf(t);
          return escape(w.slice(0, at)) + `<mark>${escape(w.slice(at, at + t.length))}</mark>` + escape(w.slice(at + t.length));
        })
        .join("");
    };

    let sel = -1;
    const rows = () => [...list.querySelectorAll<HTMLAnchorElement>("a.lx-row")];
    const select = (i: number) => {
      const r = rows();
      if (!r.length) return;
      sel = (i + r.length) % r.length;
      r.forEach((el, j) => {
        el.setAttribute("aria-selected", String(j === sel));
        el.id = `hr-${j}`;
      });
      input.setAttribute("aria-activedescendant", `hr-${sel}`);
      r[sel].scrollIntoView({ block: "nearest" });
    };

    const render = () => {
      const q = input.value.trim();
      sel = -1;
      input.removeAttribute("aria-activedescendant");
      if (!q) {
        list.innerHTML = popularHTML;
        say.textContent = "Type a few words, like “spotlight” or “tabs”.";
        return;
      }
      const hits = find(q);
      if (!hits.length) {
        list.innerHTML = `<li class="lx-empty" role="presentation">No answer for “${escape(q)}” yet. <a href="mailto:${site.contact}">Email us</a> and we’ll help.</li>`;
        say.textContent = "No results.";
        return;
      }
      list.innerHTML = hits
        .map((a) => `<li role="presentation"><a class="lx-row" role="option" aria-selected="false" href="#${a.id}"><span class="lx-title">${mark(a.q, q)}</span><span class="lx-sub">${escape(a.topic)}</span></a></li>`)
        .join("");
      say.textContent = `${hits.length} ${hits.length === 1 ? "answer" : "answers"}`;
      select(0);
    };

    /** Opens an answer; anchors.ts then scrolls to it and flashes it. */
    const open = (id: string) => {
      const d = document.getElementById(id);
      if (d instanceof HTMLDetailsElement) d.open = true;
    };

    input.addEventListener("input", render);
    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") (e.preventDefault(), select(sel + 1));
      else if (e.key === "ArrowUp") (e.preventDefault(), select(sel - 1));
      else if (e.key === "Enter") {
        e.preventDefault();
        (rows()[sel] ?? rows()[0])?.click();
      }
    });
    list.addEventListener("click", (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>("a.lx-row");
      if (a) open(a.hash.slice(1));
    });
    document.addEventListener("keydown", (e) => {
      const t = e.target as HTMLElement;
      if (e.key === "/" && !e.metaKey && !e.ctrlKey && !/INPUT|TEXTAREA|SELECT/.test(t.tagName) && !t.isContentEditable) {
        e.preventDefault();
        input.focus();
      }
    });
    if (location.hash) open(decodeURIComponent(location.hash.slice(1)));
  }
</script>
