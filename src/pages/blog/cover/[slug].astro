---
/** Just a post's cover at 1200×630, for scripts/blog-covers.mjs to screenshot. Not linked, not indexed. */
import "../../../styles/global.css";
import Cover from "../../../components/blog/Cover.astro";
import { getPosts, type Post } from "../../../lib/blog";

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{post.data.title}</title>
  </head>
  <body>
    <Cover cover={post.data.cover} alt={post.data.coverAlt} class="shot" />
  </body>
</html>
<style is:global>
  body {
    margin: 0;
    width: 1200px;
    height: 630px;
    overflow: hidden;
  }
  .shot.cover {
    width: 1200px;
    border-radius: 0 !important;
  }
</style>
