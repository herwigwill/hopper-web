---
/**
 * One blog post. Answer first (for readers in a hurry, featured snippets and AI answers), then the post, its FAQ, who
 * wrote it and what to read next. Structured data (lib/blog.ts) says the same things to machines.
 */
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Cover from "../../components/blog/Cover.astro";
import PostCard from "../../components/blog/PostCard.astro";
import Join from "../../moments/Join.astro";
import { authors } from "../../content/authors";
import { getPosts, postPath, coverPng, readingMinutes, formatDate, isoDate, postJsonLd, ldJson, type Post } from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

interface Props {
  post: Post;
  posts: Post[];
}
const { post, posts } = Astro.props;
const { data } = post;
const { Content } = await render(post);
const author = authors[data.author];
const more = posts.filter((p) => p.id !== post.id).slice(0, 2);
---
<Base
  title={`${data.title} · Hopper`}
  description={data.description}
  path={postPath(post)}
  image={coverPng(post)}
  imageAlt={data.coverAlt}
  article={{ published: data.date, modified: data.updated, author: author.name }}
>
  <script slot="head" type="application/ld+json" is:inline set:html={ldJson(postJsonLd(post))} />

  <article class="post" aria-labelledby="post-title">
    <header class="wrap head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/blog">Blog</a><span aria-hidden="true">/</span><a href={data.feature.href}>{data.feature.label}</a>
      </nav>
      <h1 id="post-title">{data.title}</h1>
      <p class="meta">
        <span class:list={["av", `av-${author.tone}`]} aria-hidden="true">{author.initials}</span>
        <span><b>{author.name}</b>, {author.role}</span>
        <span aria-hidden="true">·</span>
        <time datetime={isoDate(data.date)}>{formatDate(data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes(post)} min read</span>
        {data.updated && <span class="upd">Updated <time datetime={isoDate(data.updated)}>{formatDate(data.updated)}</time></span>}
      </p>
    </header>

    <div class="wrap cover-wrap">
      <Cover cover={data.cover} alt={data.coverAlt} />
    </div>

    <div class="wrap body">
      <aside class="answer" aria-labelledby="answer-title">
        <h2 id="answer-title">The short answer</h2>
        <p>{data.answer}</p>
        <ul>{data.takeaways.map((t) => <li>{t}</li>)}</ul>
      </aside>

      <div class="prose">
        <Content />
      </div>

      {data.faq.length > 0 && (
        <section class="faq" aria-labelledby="faq-title">
          <h2 id="faq-title">Questions people ask</h2>
          {data.faq.map((f) => (
            <div class="qa">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))}
        </section>
      )}

      <footer class="by">
        <span class:list={["av", "lg", `av-${author.tone}`]} aria-hidden="true">{author.initials}</span>
        <p><b>{author.name}</b>, {author.role}. {author.bio} <a href="/about">About the team</a></p>
      </footer>
    </div>
  </article>

  {more.length > 0 && (
    <section class="more" aria-labelledby="more-title">
      <div class="wrap">
        <h2 id="more-title">Keep reading.</h2>
        <ul class="cards">{more.map((p) => <li><PostCard post={p} /></li>)}</ul>
      </div>
    </section>
  )}

  <Join />
</Base>

<style>
  .post {
    padding-block: clamp(1.5rem, 1rem + 2.5vw, 3.5rem) clamp(3rem, 2rem + 4vw, 6rem);
  }
  .head {
    max-width: 52rem;
  }
  .crumbs {
    display: flex;
    gap: 0.6rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-2);
  }
  .crumbs a {
    color: var(--blue);
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  h1 {
    margin-top: 1.25rem;
    font-size: clamp(2.4rem, 1.5rem + 3.6vw, 4.5rem);
    max-width: 18ch;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    margin-top: 1.5rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .meta b {
    color: var(--ink);
  }
  .upd {
    flex-basis: 100%;
  }
  .av {
    display: inline-grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    flex: none;
    border-radius: 0.5rem;
    font: 700 0.72rem var(--text);
    color: #fff;
  }
  .av.lg {
    width: 2.75rem;
    height: 2.75rem;
    font-size: 0.9rem;
  }
  .av-blue {
    background: var(--blue);
  }
  .av-night {
    background: #3a3f63;
  }
  .cover-wrap {
    margin-top: clamp(1.75rem, 1rem + 2vw, 3rem);
    max-width: 68rem;
  }
  .body {
    max-width: 44rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  .answer {
    padding: 1.5rem 1.6rem;
    border-radius: 1.1rem;
    background: var(--blue-soft);
    border-left: 4px solid var(--blue);
  }
  .answer h2 {
    font-size: var(--step-0);
    font-family: var(--text);
    font-weight: 700;
    font-stretch: 100%;
    letter-spacing: 0;
    color: var(--blue-deep);
  }
  .answer p {
    margin-top: 0.6rem;
    font-size: var(--step-1);
    line-height: 1.4;
  }
  .answer ul {
    margin: 1rem 0 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.4rem;
  }

  /* The post itself, from Markdown. */
  .prose {
    margin-top: 2.5rem;
    font-size: 1.125rem;
    line-height: 1.65;
  }
  .prose :global(> * + *) {
    margin-top: 1.15em;
  }
  .prose :global(h2) {
    margin-top: 2.2em;
    font-size: var(--step-2);
    max-width: 22ch;
    scroll-margin-top: 6rem;
  }
  .prose :global(h3) {
    margin-top: 1.8em;
    font-size: var(--step-1);
    scroll-margin-top: 6rem;
  }
  .prose :global(h2 + *),
  .prose :global(h3 + *) {
    margin-top: 0.6em;
  }
  .prose :global(a) {
    color: var(--blue);
    text-underline-offset: 0.18em;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3em;
  }
  .prose :global(li + li) {
    margin-top: 0.4em;
  }
  .prose :global(strong) {
    font-weight: 700;
  }
  .prose :global(blockquote) {
    margin-inline: 0;
    padding-left: 1.2em;
    border-left: 3px solid var(--sun);
    font-size: var(--step-1);
    line-height: 1.35;
  }
  /* Keys in posts: <kbd>⌘</kbd><kbd>Space</kbd> */
  .prose :global(kbd) {
    display: inline-grid;
    place-items: center;
    min-width: 1.75em;
    height: 1.6em;
    padding: 0 0.4em;
    margin-inline: 0.06em;
    border-radius: 0.4em;
    font: 500 0.85em var(--mac);
    line-height: 1;
    color: var(--ink);
    background: linear-gradient(#fff, #f1f2f7);
    box-shadow:
      0 0 0 1px #d6d9e6,
      0 2px 0 #c2c7dc;
    vertical-align: 0.08em;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95em;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 0.6em 0.8em 0.6em 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    font-weight: 700;
  }
  .prose :global(code) {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.9em;
    padding: 0.1em 0.35em;
    border-radius: 0.3em;
    background: var(--blue-soft);
  }

  .faq {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--line);
  }
  .faq h2 {
    font-size: var(--step-2);
  }
  .qa {
    margin-top: 1.75rem;
  }
  .qa h3 {
    font-size: var(--step-0);
    font-family: var(--text);
    font-weight: 700;
    font-stretch: 100%;
    letter-spacing: 0;
  }
  .qa p {
    margin-top: 0.4rem;
    color: var(--ink-2);
  }

  .by {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-top: 3.5rem;
    padding: 1.25rem 0;
    border-block: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .by b {
    color: var(--ink);
  }
  .by a {
    color: var(--blue);
  }

  .more {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem);
    background: var(--white);
    border-top: 1px solid var(--line);
  }
  .cards {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  @media (max-width: 48rem) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
