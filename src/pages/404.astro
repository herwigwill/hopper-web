---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found · Hopper" path="/404" noindex>
  <section class="wrap msg">
    <h1>Lost your place?</h1>
    <p>There’s nothing at this address. Hopper can’t help with that one yet.</p>
    <a href="/">Go to the Hopper page</a>
  </section>
</Base>
<style>
  .msg { padding-block: 6rem 8rem; display: grid; gap: 1.25rem; justify-items: start; }
  h1 { font-size: var(--step-3); }
  p { font-size: var(--step-1); color: var(--ink-2); }
</style>
