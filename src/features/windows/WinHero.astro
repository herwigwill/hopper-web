---
/**
 * The Windows page's hero: Hopper's launcher beside a Mac display. Type a window command (or pick one) and the window
 * in front moves, with the gap and the ½ → ⅔ → ⅓ repeat Hopper uses. Plays on its own until the visitor takes over;
 * pauses off-screen and never autoplays under reduced motion.
 */
import "../../styles/launcher.css";
import MacWindow from "../../components/MacWindow.astro";
import { apps, windowCommands, windowGaps } from "../../content/facts";
import { glyphSVG, commandSub } from "../../scripts/windows";

const first = windowCommands.slice(0, 9);
const wins = [
  { app: "notion", title: "Q4 Launch Plan", at: { x: 0.05, y: 0.07, w: 0.5, h: 0.72 }, z: 1 },
  { app: "slack", title: "#launch", at: { x: 0.2, y: 0.36, w: 0.46, h: 0.58 }, z: 2 },
  { app: "chrome", title: "Checkout funnel, Q4", at: { x: 0.4, y: 0.04, w: 0.55, h: 0.62 }, z: 3 },
] as const;
---
<section class="wh" id="commands" aria-labelledby="wh-title" data-wh>
  <div class="wrap intro">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/features">Features</a><span aria-hidden="true">/</span><span aria-current="page">Windows</span>
    </nav>
    <h1 id="wh-title">Every window, right where you want&nbsp;it.</h1>
    <p class="lede">42 window commands in the launcher, sizes you make yourself, and whole layouts on one key. Type what you want, or give any of them a hotkey.</p>
  </div>

  <div class="wrap">
    <div class="stage on-blue" data-stage>
      <p class="visually-hidden" id="wh-desc">
        A demonstration of Hopper’s window commands. On the left is Hopper’s launcher, listing window commands; on the
        right, a Mac display with three windows. Running a command moves the window in front. It plays on its own; use
        the search field to try a command yourself.
      </p>

      <div class="lx-col">
        <div class="lx wh-lx" id="wh-lx" data-launcher>
          <div class="lx-head">
            <div class="lx-field">
              <label class="visually-hidden" for="wh-q">Try a window command in the demo</label>
              <input
                class="lx-input"
                id="wh-q"
                type="text"
                autocomplete="off"
                spellcheck="false"
                role="combobox"
                aria-controls="wh-list"
                aria-expanded="true"
                aria-autocomplete="list"
                aria-describedby="wh-desc"
                aria-activedescendant="wh-left-half"
              />
              <span class="lx-text" data-text></span><span class="lx-caret" aria-hidden="true"></span><span class="lx-placeholder" data-placeholder>Search window commands…</span>
            </div>
          </div>
          <div class="lx-rule"></div>
          <p class="lx-section" data-section>Window Management</p>
          <ul class="lx-list" id="wh-list" role="listbox" aria-label="Window commands" data-list>
            {first.map((c, i) => (
              <li class="lx-row" role="option" id={`wh-${c.id}`} data-id={c.id} aria-selected={i === 0 ? "true" : "false"}>
                <span class="lx-ico" set:html={glyphSVG(c.id)} />
                <span class="lx-title">{c.title}</span>
                <span class="lx-sub">{commandSub(c.id)}</span>
              </li>
            ))}
          </ul>
          <div class="lx-rule"></div>
          <div class="lx-foot" aria-hidden="true">
            <span data-target>Moves <b>Chrome</b></span>
            <span class="lx-primary">Run Command</span><span class="lx-kbd" data-enter>↵</span>
          </div>
        </div>
      </div>

      <div class="display" aria-hidden="true">
        <div class="menubar">
          <span class="mb-apple"></span>
          <span class="mb-app" data-menubar-app>Chrome</span>
          <span class="mb-more">File</span><span class="mb-more">Edit</span><span class="mb-more">View</span>
          <span class="mb-clock">9:41 AM</span>
        </div>
        <div class="desk" data-desk>
          {wins.map((w) => <MacWindow app={w.app} title={w.title} at={w.at} z={w.z} front={w.app === "chrome"} />)}
          <p class="hud" data-hud hidden></p>
        </div>
        <div class="dock">
          {(["notion", "chrome", "slack"] as const).map((a) => <img src={apps[a].icon} alt="" width="28" height="28" data-dock={a} />)}
        </div>
      </div>

      <button type="button" class="pause" data-pause aria-pressed="false" aria-label="Pause demo">
        <span class="ico" data-icon-pause><svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3.5" y="3" width="3" height="10" rx="1"/><rect x="9.5" y="3" width="3" height="10" rx="1"/></svg></span>
        <span class="ico" data-icon-play hidden><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3v10l8-5z"/></svg></span>
      </button>
    </div>

    <div class="controls">
      <div class="seg" role="radiogroup" aria-label="Window in front" data-front-group>
        <span class="seg-label" aria-hidden="true">In front</span>
        {(["notion", "slack", "chrome"] as const).map((a) => (
          <button type="button" role="radio" aria-checked={a === "chrome" ? "true" : "false"} data-front={a}>
            <img src={apps[a].icon} alt="" width="18" height="18" />{apps[a].short}
          </button>
        ))}
      </div>
      <div class="seg" role="radiogroup" aria-label="Window Gap" data-gap-group>
        <span class="seg-label" aria-hidden="true">Window Gap</span>
        {windowGaps.map((g) => (
          <button type="button" role="radio" aria-checked={g === 0 ? "true" : "false"} data-gap={g} aria-label={g ? `${g} points` : "None"}>{g || "None"}</button>
        ))}
      </div>
    </div>
    <p class="visually-hidden" aria-live="polite" data-wh-live></p>
  </div>
</section>

<style>
  .wh {
    padding-top: clamp(1.5rem, 1rem + 2.5vw, 3.5rem);
    padding-bottom: clamp(4rem, 3rem + 5vw, 8rem);
  }
  .crumbs {
    display: flex;
    gap: 0.6rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-2);
    margin-bottom: 1.5rem;
  }
  .crumbs a {
    color: var(--blue);
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 5vw, 5rem);
    align-items: end;
  }
  .crumbs {
    grid-column: 1 / -1;
  }
  h1 {
    max-width: 11ch;
    font-size: clamp(3rem, 1.6rem + 5.2vw, 6.25rem);
    view-transition-name: title-windows;
  }
  .lede {
    padding-bottom: 0.5rem;
  }
  @media (max-width: 56rem) {
    .intro {
      grid-template-columns: 1fr;
    }
  }

  .stage {
    position: relative;
    margin-top: clamp(2rem, 1.5rem + 2.5vw, 3.5rem);
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.38fr);
    gap: clamp(1rem, 2vw, 1.75rem);
    padding: clamp(1rem, 2.2vw, 2rem);
    border-radius: clamp(18px, 2vw, 28px);
    background:
      radial-gradient(120% 90% at 85% 0%, #4a58ff 0%, transparent 55%),
      var(--blue);
    color: var(--white);
    view-transition-name: stage-windows;
  }

  /* The launcher, filling its column. */
  .lx-col {
    container-type: inline-size;
    min-width: 0;
    display: flex;
  }
  .wh-lx {
    --lx-size: clamp(11px, calc(100cqw / 31), 13.5px);
    width: 100%;
    display: flex;
    flex-direction: column;
  }
  /* Basis 0: the display's height sets the row, never the list's length, so filtering doesn't shift the page. */
  .wh-lx .lx-list {
    flex: 1 1 0;
    height: auto;
    min-height: 12em;
    overflow-y: auto;
    scrollbar-width: none;
  }
  .wh-lx .lx-list::-webkit-scrollbar {
    display: none;
  }
  .wh-lx :global(.lx-row) {
    cursor: pointer;
  }
  .wh-lx :global(.lx-ico) {
    display: grid;
    place-items: center;
    color: #c9d0ff;
  }
  .wh-lx :global(.lx-row[aria-selected="true"] .lx-ico) {
    color: #fff;
  }
  .wh-lx :global(.lx-sub) {
    display: none;
  }
  .wh-lx :global(.lx-row[aria-selected="true"] .lx-sub) {
    display: block;
    margin-left: auto;
    max-width: 50%;
  }
  .wh-lx :global(.lx-foot b) {
    color: #fff;
    font-weight: 600;
  }

  /* The display: a menu bar, the desk (the visible area), and a Dock. */
  .display {
    position: relative;
    min-width: 0;
    align-self: center;
    border-radius: 12px;
    overflow: hidden;
    background:
      radial-gradient(90% 80% at 20% 100%, #6a3df0 0%, transparent 60%),
      radial-gradient(80% 70% at 100% 0%, #31c0ff 0%, transparent 55%),
      #2534c9;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.18), 0 30px 60px -30px rgb(6 8 40 / 0.7);
  }
  .menubar {
    display: flex;
    gap: 1rem;
    align-items: center;
    height: 1.6rem;
    padding: 0 0.8rem;
    font-family: var(--mac);
    font-size: 0.75rem;
    background: rgb(12 18 90 / 0.3);
  }
  .mb-apple {
    width: 0.7rem;
    height: 0.8rem;
    border-radius: 40% 40% 45% 45%;
    background: rgb(255 255 255 / 0.9);
  }
  .mb-app {
    font-weight: 700;
    min-width: 3.5rem;
  }
  .mb-clock {
    margin-left: auto;
  }
  .desk {
    margin: 0;
  }
  .dock {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    width: max-content;
    margin: 0.35rem auto 0.45rem;
    padding: 0.3rem 0.5rem;
    border-radius: 0.8rem;
    background: rgb(255 255 255 / 0.18);
    box-shadow: inset 0 0 0 0.5px rgb(255 255 255 / 0.3);
  }
  .dock img {
    width: clamp(1.1rem, 2vw, 1.6rem);
    height: auto;
  }
  .hud {
    position: absolute;
    left: 50%;
    bottom: 8%;
    z-index: 50;
    transform: translateX(-50%);
    padding: 0.55em 1.1em;
    border-radius: 0.8em;
    background: rgb(28 28 34 / 0.88);
    color: #fff;
    font-family: var(--mac);
    font-size: clamp(0.7rem, 1.2vw, 0.9rem);
    white-space: nowrap;
    animation: hud 2.2s ease both;
  }
  @keyframes hud {
    0% { opacity: 0; transform: translate(-50%, 8px); }
    10%, 85% { opacity: 1; transform: translate(-50%, 0); }
    100% { opacity: 0; }
  }

  .pause {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 5;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 50%;
    background: rgb(12 18 90 / 0.45);
    color: #fff;
    cursor: pointer;
  }
  .pause svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 1.25rem;
  }
  .seg {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem;
    border-radius: 14px;
    background: var(--white);
    border: 1px solid var(--line);
  }
  .seg-label {
    padding: 0 0.6rem 0 0.5rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-2);
  }
  .seg button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.25rem;
    padding: 0 0.8rem;
    border: 0;
    border-radius: 10px;
    background: transparent;
    font-size: var(--step--1);
    font-weight: 600;
    cursor: pointer;
  }
  .seg button img {
    width: 18px;
    height: 18px;
  }
  .seg button:hover {
    background: var(--paper);
  }
  .seg button[aria-checked="true"] {
    background: var(--ink);
    color: var(--white);
  }

  @media (max-width: 56rem) {
    .stage {
      grid-template-columns: 1fr;
    }
    .lx-col {
      order: 2;
    }
    .wh-lx .lx-list {
      flex: none;
      height: 15.5em;
      min-height: 0;
    }
    .pause {
      top: 0.75rem;
      bottom: auto;
    }
    .mb-clock {
      visibility: hidden;
    }
  }
</style>

<script>
  import { initWindowsHero } from "../../scripts/winhero";
  const root = document.querySelector<HTMLElement>("[data-wh]");
  if (root) initWindowsHero(root);
</script>
