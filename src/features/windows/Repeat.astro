---
/**
 * "Press it again": Repeat a Half (ADR-052). Running a half again on a window still where Hopper put it steps
 * ½ → ⅔ → ⅓ (the default), or moves it on to the next display that way as its opposite half, or does nothing more.
 * Two displays; the window flies between them.
 */
import MacWindow from "../../components/MacWindow.astro";
import { glyphSVG } from "../../scripts/windows";
---
<section class="rp" id="repeat" aria-labelledby="rp-title" data-rp>
  <div class="wrap grid">
    <div class="copy">
      <p class="kicker">Repeat a Half</p>
      <h2 id="rp-title">Press it again.</h2>
      <p class="lede">Run a half twice and the window gets wider, then narrower: ½, ⅔, ⅓. Or have it carry on to your next display.</p>

      <div class="keys-row" role="group" aria-label="Try it">
        <button type="button" class="cmd" data-cmd="left-half">
          <span set:html={glyphSVG("left-half")} />Left Half
        </button>
        <button type="button" class="cmd" data-cmd="right-half">
          <span set:html={glyphSVG("right-half")} />Right Half
        </button>
      </div>

      <fieldset class="mode">
        <legend>When you run a half again</legend>
        <label><input type="radio" name="rp-mode" value="steps" checked /> Step ½ → ⅔ → ⅓</label>
        <label><input type="radio" name="rp-mode" value="display" /> Move on to the next display</label>
        <label><input type="radio" name="rp-mode" value="none" /> Do nothing more</label>
      </fieldset>
    </div>

    <div class="scene" aria-hidden="true">
      <div class="readout"><span class="frac" data-frac>½</span><span class="frac-l" data-frac-l>of the display</span></div>
      <div class="pair" data-pair>
        <div class="screen s-laptop"><div class="desk" data-desk="0"></div><span class="bezel">Built-in Display</span></div>
        <div class="screen s-ext"><div class="desk" data-desk="1"></div><span class="bezel">Studio Display</span></div>
        <div class="flyer" data-flyer>
          <MacWindow app="notion" title="Q4 Launch Plan" at={{ x: 0, y: 0, w: 0.5, h: 1 }} front />
        </div>
      </div>
    </div>
  </div>
  <p class="visually-hidden" aria-live="polite" data-rp-live></p>
</section>

<style>
  .rp {
    padding-block: clamp(5rem, 4rem + 6vw, 9rem);
    background: var(--white);
    border-block: 1px solid var(--line);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 3rem clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .kicker {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 1rem;
  }
  .lede {
    margin-top: 1.5rem;
  }
  .keys-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .cmd {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 3rem;
    padding: 0 1.1rem 0 0.8rem;
    border: 1px solid #c9cde0;
    border-radius: 14px;
    background: linear-gradient(#fff, #f1f2f7);
    box-shadow: 0 2px 0 #c2c7dc, 0 3px 8px rgb(18 24 51 / 0.1);
    font-weight: 700;
    color: var(--ink);
    cursor: pointer;
    transition: transform 90ms ease, box-shadow 90ms ease, border-color 150ms ease;
  }
  .cmd:hover {
    border-color: var(--blue);
  }
  .cmd:active,
  .cmd.is-down {
    transform: translateY(2px);
    box-shadow: 0 0 0 #c2c7dc, 0 1px 2px rgb(18 24 51 / 0.12);
  }
  .cmd :global(.glyph) {
    width: 1.6rem;
    color: var(--blue);
  }
  .mode {
    margin: 1.75rem 0 0;
    padding: 0;
    border: 0;
    display: grid;
    gap: 0.5rem;
  }
  .mode legend {
    padding: 0;
    margin-bottom: 0.6rem;
    font-weight: 700;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .mode label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
  }
  .mode input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--blue);
    margin: 0;
  }

  .scene {
    position: relative;
  }
  .readout {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .frac {
    font-family: var(--display);
    font-weight: 800;
    font-stretch: 80%;
    font-size: clamp(3rem, 2rem + 4vw, 5.5rem);
    line-height: 0.9;
    color: var(--blue);
    min-width: 1.2ch;
    display: inline-block;
  }
  .frac.pop {
    animation: pop 420ms var(--ease-hop);
  }
  @keyframes pop {
    from {
      transform: translateY(10px) scale(0.8);
      opacity: 0.2;
    }
  }
  .frac-l {
    color: var(--ink-2);
    font-weight: 600;
  }
  .pair {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    align-items: end;
  }
  .screen {
    display: grid;
    gap: 0.4rem;
  }
  .screen .desk {
    border-radius: 8px;
    background:
      radial-gradient(90% 80% at 20% 100%, #6a3df0 0%, transparent 60%),
      radial-gradient(80% 70% at 100% 0%, #31c0ff 0%, transparent 55%),
      #2534c9;
    box-shadow: 0 0 0 5px #15172a, 0 0 0 6px #3a3d55, 0 20px 40px -20px rgb(6 8 40 / 0.6);
  }
  .bezel {
    margin-top: 0.4rem;
    text-align: center;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  .flyer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .flyer :global(.mw) {
    transition:
      left 520ms var(--ease-hop),
      top 520ms var(--ease-hop),
      width 520ms var(--ease-hop),
      height 520ms var(--ease-hop);
  }

  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { press } from "../../scripts/launcher";
  import { HALF_STEPS, HALF_LABELS } from "../../scripts/windows";

  const root = document.querySelector<HTMLElement>("[data-rp]");
  if (root) {
    const pair = root.querySelector<HTMLElement>("[data-pair]")!;
    const desks = [...root.querySelectorAll<HTMLElement>("[data-desk]")];
    const win = root.querySelector<HTMLElement>("[data-flyer] .mw")!;
    const frac = root.querySelector<HTMLElement>("[data-frac]")!;
    const fracL = root.querySelector<HTMLElement>("[data-frac-l]")!;
    const live = root.querySelector<HTMLElement>("[data-rp-live]")!;
    type Side = "left-half" | "right-half";
    let display = 0;
    let side: Side = "left-half";
    let step = 0;

    const mode = () => (root.querySelector<HTMLInputElement>('input[name="rp-mode"]:checked')?.value ?? "steps") as "steps" | "display" | "none";

    const place = (hop = false) => {
      const p = pair.getBoundingClientRect();
      const d = desks[display].getBoundingClientRect();
      const w = HALF_STEPS[step] * d.width;
      const x = side === "left-half" ? d.left - p.left : d.left - p.left + d.width - w;
      const st = win.style;
      st.setProperty("--pt", `${d.width / 1440}px`);
      st.left = `${x}px`;
      st.top = `${d.top - p.top}px`;
      st.width = `${w}px`;
      st.height = `${d.height}px`;
      if (hop && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        win.animate([{ transform: "none" }, { transform: "translateY(-14%) scale(0.92)" }, { transform: "none" }], { duration: 520, easing: "ease-out" });
      }
    };

    const show = (label: string, sub: string) => {
      if (frac.textContent !== label) {
        frac.textContent = label;
        frac.classList.remove("pop");
        void frac.offsetWidth;
        frac.classList.add("pop");
      }
      fracL.textContent = sub;
    };
    const describe = () => show(HALF_LABELS[step], display === 0 ? "of the built-in display" : "of the Studio Display");

    const runHalf = (cmd: Side) => {
      const again = cmd === side;
      let hop = false;
      if (!again) {
        side = cmd;
        step = 0;
      } else if (mode() === "steps") {
        step = (step + 1) % 3;
      } else if (mode() === "display") {
        // On to the display that way, as its opposite half.
        const next = cmd === "right-half" ? display + 1 : display - 1;
        if (next < 0 || next >= desks.length) {
          live.textContent = "No display that way.";
          win.animate([{ transform: "none" }, { transform: `translateX(${cmd === "right-half" ? 2 : -2}%)` }, { transform: "none" }], { duration: 260 });
          return;
        }
        display = next;
        side = cmd === "right-half" ? "left-half" : "right-half";
        step = 0;
        hop = true;
      } else {
        live.textContent = "Already there.";
        return;
      }
      place(hop);
      describe();
      live.textContent = `${side === "left-half" ? "Left" : "Right"} half, ${["one half", "two thirds", "one third"][step]}, on the ${display === 0 ? "built-in display" : "Studio Display"}.`;
    };

    root.querySelectorAll<HTMLButtonElement>("[data-cmd]").forEach((b) =>
      b.addEventListener("click", () => {
        press(b, 140);
        runHalf(b.dataset.cmd as Side);
      }),
    );
    root.querySelectorAll<HTMLInputElement>('input[name="rp-mode"]').forEach((r) =>
      r.addEventListener("change", () => {
        step = 0;
        place();
        describe();
      }),
    );
    new ResizeObserver(() => {
      win.style.transition = "none";
      place();
      void win.offsetWidth;
      win.style.transition = "";
    }).observe(pair);
    place();
    describe();
  }
</script>
