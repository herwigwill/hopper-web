---
/**
 * The waitlist form, styled as Hopper's own search field. Works without JavaScript (posts to /api/waitlist and
 * lands on a static page); src/scripts/waitlist.ts enhances it in place.
 */
interface Props {
  id: string;
  tone?: "paper" | "blue";
}
const { id, tone = "paper" } = Astro.props;
---
<div class:list={["waitlist", `tone-${tone}`]} data-waitlist>
  <form class="join-form" action="/api/waitlist" method="post" novalidate data-join>
    <input type="hidden" name="intent" value="join" />
    <input type="hidden" name="t" value="" data-opened />
    <div class="hp" aria-hidden="true">
      <label for={`${id}-company`}>Company</label>
      <input id={`${id}-company`} name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <label class="visually-hidden" for={`${id}-email`}>Email address</label>
    <div class="field">
      <svg class="glass" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="m13 13 4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <input
        id={`${id}-email`}
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        autocapitalize="off"
        spellcheck="false"
        required
        maxlength="254"
        placeholder="you@example.com"
        aria-describedby={`${id}-note ${id}-error`}
      />
      <button type="submit" class="submit">
        <span class="label">Join the waitlist</span>
        <span class="enter" aria-hidden="true">↵</span>
      </button>
    </div>
    <p class="error" id={`${id}-error`} role="alert" data-error></p>
    <p class="note" id={`${id}-note`}>For {"macOS 26"} and later. One email when Hopper is ready, nothing else.</p>
  </form>

  <div class="done" data-done hidden tabindex="-1">
    <p class="done-title" data-done-title>You’re on the list.</p>
    <p class="done-body" data-done-body>We’ll email you when Hopper is ready for you.</p>
    <form class="details" action="/api/waitlist" method="post" data-details>
      <input type="hidden" name="intent" value="details" />
      <input type="hidden" name="email" value="" />
      <input type="hidden" name="token" value="" />
      <p class="ask">Two optional questions help us pick early testers:</p>
      <fieldset>
        <legend>What do you use to find things on your Mac today?</legend>
        <div class="choices">
          {[["spotlight", "Spotlight"], ["raycast", "Raycast"], ["alfred", "Alfred"], ["other", "Something else"], ["nothing", "Nothing really"]].map(([v, l]) => (
            <label><input type="radio" name="uses" value={v} /><span>{l}</span></label>
          ))}
        </div>
      </fieldset>
      <fieldset>
        <legend>Do you run AI coding agents like Claude Code, Cursor or Codex?</legend>
        <div class="choices">
          {[["yes", "Every day"], ["sometimes", "Sometimes"], ["no", "No"]].map(([v, l]) => (
            <label><input type="radio" name="agents" value={v} /><span>{l}</span></label>
          ))}
        </div>
      </fieldset>
      <div class="details-actions">
        <button type="submit" class="save">Save answers</button>
        <p class="details-status" role="status" data-details-status></p>
      </div>
    </form>
  </div>
</div>

<style>
  .waitlist {
    width: 100%;
    max-width: 34rem;
  }
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .field {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.4rem 0.4rem 1rem;
    border-radius: 14px;
    background: #eceef5;
    border: 1px solid #d3d7e5;
    color: var(--ink);
    transition: box-shadow 160ms ease, border-color 160ms ease, background 160ms ease;
  }
  .field:hover {
    border-color: #c3c8da;
  }
  .field:focus-within {
    background: var(--white);
    border-color: var(--blue);
    box-shadow: 0 0 0 3px rgb(43 59 245 / 0.18);
  }
  .tone-blue .field {
    background: var(--white);
    border-color: transparent;
    box-shadow: 0 18px 40px -20px rgb(10 14 60 / 0.5);
  }
  .tone-blue .field:focus-within {
    border-color: var(--sun);
    box-shadow: 0 0 0 3px var(--sun), 0 18px 40px -20px rgb(10 14 60 / 0.5);
  }
  .glass {
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
    opacity: 0.55;
  }
  input[type="email"] {
    flex: 1;
    min-width: 0;
    height: 3rem;
    border: 0;
    outline: 0;
    background: transparent;
    color: inherit;
    font-family: var(--mac);
    font-size: 1.25rem;
    caret-color: var(--blue);
  }
  input[type="email"]::placeholder {
    color: #6a7090;
  }
  .submit {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3rem;
    padding: 0 0.6rem 0 1.1rem;
    border: 0;
    border-radius: 10px;
    background: var(--blue);
    color: var(--white);
    font-weight: 650;
    font-size: 1rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background 150ms ease;
  }
  .submit:hover {
    background: var(--blue-deep);
  }
  .submit:focus-visible {
    outline-offset: 2px;
  }
  .enter {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.18);
    font-family: var(--mac);
    font-size: 0.95rem;
  }
  .tone-blue .submit {
    background: var(--blue);
    color: var(--white);
  }
  .tone-blue .submit:hover {
    background: var(--blue-deep);
  }
  .tone-blue .enter {
    background: rgb(255 255 255 / 0.18);
  }
  [aria-busy="true"] .submit {
    opacity: 0.7;
    cursor: progress;
  }
  .error {
    min-height: 0;
    margin-top: 0.6rem;
    font-weight: 600;
    color: #b3122e;
  }
  .error:empty {
    display: none;
  }
  .tone-blue .error {
    color: var(--white);
    background: #b3122e;
    padding: 0.4rem 0.7rem;
    border-radius: 8px;
    display: inline-block;
  }
  .tone-blue .error:empty {
    display: none;
  }
  .note {
    margin-top: 0.75rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .tone-blue .note {
    color: rgb(255 255 255 / 0.82);
  }
  .done {
    padding: 1.25rem 1.25rem 1.4rem;
    border-radius: 16px;
    background: var(--white);
    color: var(--ink);
    box-shadow: 0 18px 40px -22px rgb(15 20 51 / 0.45);
    outline: none;
  }
  .done-title {
    font-family: var(--display);
    font-weight: 800;
    font-stretch: 85%;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
  }
  .done-body {
    margin-top: 0.25rem;
    color: var(--ink-2);
  }
  .ask {
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  fieldset {
    margin: 0.9rem 0 0;
    padding: 0;
    border: 0;
  }
  legend {
    padding: 0;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }
  .choices label {
    position: relative;
  }
  .choices input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .choices span {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--paper);
    font-size: 0.9rem;
    transition: background 120ms ease, border-color 120ms ease;
  }
  .choices input:checked + span {
    background: var(--blue);
    border-color: var(--blue);
    color: var(--white);
  }
  .choices input:focus-visible + span {
    outline: 3px solid var(--blue);
    outline-offset: 2px;
  }
  .details-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.1rem;
  }
  .save {
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 0;
    border-radius: 10px;
    background: var(--ink);
    color: var(--white);
    font-weight: 600;
    cursor: pointer;
  }
  .details-status {
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  @media (max-width: 30rem) {
    .field {
      flex-wrap: wrap;
      padding: 0.4rem;
    }
    .glass {
      margin-left: 0.6rem;
    }
    input[type="email"] {
      flex-basis: calc(100% - 2.5rem);
      font-size: 1.125rem;
    }
    .submit {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>

<script>
  import { enhanceWaitlist } from "../scripts/waitlist";
  document.querySelectorAll<HTMLElement>("[data-waitlist]").forEach(enhanceWaitlist);
</script>
