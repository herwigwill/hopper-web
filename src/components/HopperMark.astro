---
/**
 * Hopper's mark, the bunny ears (Desktop/Hopper Final Icon Transparent*.svg, transform baked in, cropped).
 * Filled with currentColor. Each ear is its own path (`.ear-l`, `.ear-r`) so pages can move them; pivot each one at
 * its base with `transform-box: view-box` and `transform-origin: var(--pivot)`.
 */
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
