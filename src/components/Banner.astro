---
/**
 * A brand-art banner filling its positioned parent, behind the content (ASSETS.md, Banners). Decorative.
 * `motion` adds the moving loop over the still; `focus` is the object-position that keeps the light in frame.
 */
interface Props {
  name: "capsule" | "subtle" | "orange" | "wave";
  motion?: boolean;
  focus?: string;
  eager?: boolean;
  class?: string;
}
const { name, motion = false, focus = "center", eager = false, class: className } = Astro.props;
const still = (w: number) => `/banners/${name}-${w}.webp`;
---
<div class:list={["banner", className]} style={`--focus: ${focus}`} aria-hidden="true">
  <img
    src={still(1600)}
    srcset={`${still(800)} 800w, ${still(1600)} 1600w`}
    sizes="100vw"
    width="1600"
    height="900"
    alt=""
    loading={eager ? "eager" : "lazy"}
    decoding="async"
  />
  {motion && <video data-banner-video data-src={`/banners/${name}.mp4`} muted loop playsinline preload="none" tabindex="-1"></video>}
</div>

<style>
  .banner {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  img,
  video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus);
  }
  /* The loop fades in over its own first frame once it's actually playing. */
  video {
    opacity: 0;
    transition: opacity 600ms ease;
  }
  video.is-playing {
    opacity: 1;
  }
</style>

<script>
  import { initBanner } from "../scripts/banner";
  document.querySelectorAll<HTMLVideoElement>("[data-banner-video]").forEach(initBanner);
</script>
