---
import Waitlist from "../components/Waitlist.astro";
import Banner from "../components/Banner.astro";
import { site } from "../content/facts";
---
<section class="join on-blue" id="join" aria-labelledby="join-title">
  <Banner name="capsule" focus="right center" />
  <div class="wrap grid">
    <div>
      <h2 id="join-title">Be the first to try Hopper.</h2>
      <p class="sub">Hopper is in private testing now. Join the waitlist and we’ll send you a build when it’s ready.</p>
    </div>
    <div class="form">
      <p class="press" aria-hidden="true"><span class="keys"><span class="key">{site.shortcut[0]}</span><span class="key">{site.shortcut[1]}</span></span></p>
      <Waitlist tone="blue" />
    </div>
  </div>
</section>

<style>
  .join {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--blue);
    color: var(--white);
    padding-block: clamp(5rem, 4rem + 6vw, 9rem);
    margin-bottom: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2.5rem clamp(2rem, 6vw, 6rem);
    align-items: end;
  }
  h2 {
    font-size: var(--step-4);
    max-width: 9ch;
  }
  .sub {
    margin-top: 1.5rem;
    max-width: 34ch;
    font-size: var(--step-1);
    line-height: 1.45;
    color: rgb(255 255 255 / 0.86);
  }
  .press {
    margin-bottom: 1.25rem;
  }
  .press .key {
    font-size: 1.1rem;
  }
  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: 1fr;
    }
    /* Stacked, the light would sit behind the headline; keep it down behind the button. */
    .join :global(.banner) {
      top: 38%;
      -webkit-mask-image: linear-gradient(to bottom, transparent, #000 35%);
      mask-image: linear-gradient(to bottom, transparent, #000 35%);
    }
  }
</style>
